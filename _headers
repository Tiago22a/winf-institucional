/hub
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
/hub/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

# Revalidate shared footer assets; HTML references also include a release version.
/css/winf-footer.css
  Cache-Control: public, max-age=0, must-revalidate
/js/winf-footer.js
  Cache-Control: public, max-age=0, must-revalidate

# O menu GHOST+ deve receber revisões sem reter atalhos privados.
/js/winf-quick-contact.js
  Cache-Control: public, max-age=0, must-revalidate
